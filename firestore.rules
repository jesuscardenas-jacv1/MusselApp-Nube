rules_version = '2';

// Reglas de Firestore de MusselApp (proyecto musselapp-demo).
//
// Quién es quién:
// - Teléfono: sesión anónima de Firebase. Cada documento que sube lleva su uid en `ownerUid`.
// - Supervisor (portal web): cuenta con correo y contraseña que además tiene un documento en
//   `supervisores/{uid}`. Ese documento se crea a mano en la consola de Firebase.
//
// Las pruebas de estas reglas están en firestore-tests/ y corren en GitHub Actions.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function esSupervisor() {
      return conSesion()
        && exists(/databases/$(database)/documents/supervisores/$(request.auth.uid));
    }

    // El documento que ya existe es de quien hace la petición
    function esSuyo() {
      return conSesion() && resource.data.ownerUid == request.auth.uid;
    }

    // Documento subido antes de que existieran las sesiones: todavía no tiene dueño
    function sinDueno() {
      return conSesion() && !('ownerUid' in resource.data);
    }

    // Después de la escritura, el documento queda a nombre de quien la hace
    function quedaSuyo() {
      return request.resource.data.ownerUid == request.auth.uid;
    }

    // Lo que escribe quien dictamina (los mismos campos que ProteccionDictamen.CAMPOS_DEL_SUPERVISOR en la app)
    function camposDelDictamen() {
      return ['estado', 'revisadaPor', 'revisadaEn', 'comentarioSupervisor',
              'conteoIndM', 'tallaMm', 'cholgasIndM', 'valoresOperario'];
    }

    function sinDictamen() {
      return !('estado' in resource.data) || resource.data.estado == 'PENDIENTE';
    }

    // Lista de supervisores: cada cuenta solo puede comprobar si ella misma está. Se edita desde la consola.
    match /supervisores/{uid} {
      allow get: if conSesion() && request.auth.uid == uid;
    }

    match /muestras/{id} {
      // El supervisor ve, dictamina y elimina todo
      allow read, write: if esSupervisor();

      // El teléfono lee solo lo suyo. También puede consultar por id un documento que no existe
      // (la subida lee antes de escribir) o uno antiguo sin dueño, para reclamarlo.
      allow get: if conSesion() && (resource == null || esSuyo() || sinDueno());
      // La escucha del teléfono debe filtrar por ownerUid; pedir la colección completa se rechaza
      allow list: if esSuyo();

      allow create: if conSesion() && quedaSuyo();

      // El teléfono actualiza lo suyo (o reclama un documento antiguo sin dueño) y no puede pasarlo a otro.
      // Gana el primer dictamen: si la muestra ya tiene uno, el teléfono no puede tocar esos campos.
      allow update: if (esSuyo() || sinDueno())
        && quedaSuyo()
        && (sinDictamen()
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposDelDictamen()));

      // Eliminar: solo el supervisor (no hay regla de delete para el teléfono)
    }

    // Fotos: un documento por muestra, con el mismo id
    match /fotos/{id} {
      allow read, write: if esSupervisor();
      allow get: if conSesion() && (resource == null || esSuyo() || sinDueno());
      allow create: if conSesion() && quedaSuyo();
      allow update: if (esSuyo() || sinDueno()) && quedaSuyo();
    }
  }
}
